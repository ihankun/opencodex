{
  "name": "opencodex",
  "private": true,
  "version": "1.17.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src/renderer && node --test src/main/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "bun run typecheck && bun run test",
    "upstream:check": "bun ./scripts/check-upstreams.ts",
    "install:electron": "node ./node_modules/electron/install.js",
    "icons": "bun ./scripts/generate-icons.ts",
    "predev": "bun run icons && bun ./scripts/build-server.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun run icons && bun ./scripts/build-server.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage": "bun run verify && bun run build",
    "package": "electron-builder --config electron-builder.config.ts",
    "prepackage:win": "bun run verify && bun run build",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "prepackage:mac": "bun run verify && bun run build",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@opencode-ai/sdk": "workspace:*",
    "@wechatbot/wechatbot": "^2.0.1",
    "cron": "^3.5.0",
    "croner": "^9.1.0",
    "discord.js": "^14.25.1",
    "electron-updater": "^6.6.2",
    "electron-window-state": "^5.0.3",
    "express": "^4.21.0",
    "extract-zip": "2.0.1",
    "jsonc-parser": "3.3.1",
    "qq-official-bot": "^1.0.12",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@playwright/test": "catalog:",
    "@streamdown/math": "^1.0.2",
    "@types/bun": "catalog:",
    "@types/diff": "^7.0.2",
    "@types/node": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "5.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.16.25",
    "lucide-react": "1.7.0",
    "mermaid": "^11.13.0",
    "motion": "^12.38.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "17.0.1",
    "sharp": "^0.33.5",
    "shiki": "^4.0.2",
    "shiki-stream": "^0.1.4",
    "streamdown": "2.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
